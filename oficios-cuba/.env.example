# Copia a .env (chmod 600). Nunca subas .env al repo.

# Obligatorio: mínimo 32 caracteres aleatorios. Genera uno con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Obligatorio desde el porte a Postgres. El compose construye DATABASE_URL con esta contraseña
# (postgresql://oficio:${POSTGRES_PASSWORD}@oficio_db:5432/oficio), así que no hace falta
# escribir DATABASE_URL aquí salvo para correr el backend FUERA de Docker.
# Genérala con: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# Clave maestra de Meilisearch (Plan 2, todavía sin usar en producción). Mínimo 16 bytes.
MEILI_MASTER_KEY=

# 🚨 Solo en worktrees de desarrollo: ponlo a algo que NO sea "oficios-cuba". Sin él, compose
# deduce el nombre de proyecto del directorio, que es el MISMO que usa producción en vps2, y un
# `docker compose down` desde un worktree pararía los contenedores de PRODUCCIÓN.
# COMPOSE_PROJECT_NAME=oficio_dev

# true = siembra cuentas y datos de demostración y simula los pagos de planes.
DEMO_MODE=true

# Precios de los planes (USD/mes). Gratis siempre es 0.
PLAN_BASICO_USD=1
PLAN_PROFESIONAL_USD=10

# Tasa de respaldo CUP por 1 USD. La real la sirve nginx desde dardoventas.com/tasas.json.
TASA_CUP_USD=730

# Login con Google real (OAuth Client ID de tipo "Web", origen https://oficio.dardoit.com,
# redirect https://oficio.dardoit.com/auth/google). Vacío + DEMO_MODE=true = Google simulado.
# Ojo: la API necesita salida a www.googleapis.com para bajar las llaves públicas de Google.
GOOGLE_CLIENT_ID=

# Push FCM: no va aquí. Lo envía oficio_notifier con secrets/fcm/cuenta.json (ver DOCKER.md).

# Catálogo de DardoVentas: fin del plan Profesional regalado a los negocios vinculados (fecha ISO,
# p. ej. 2027-03-31). Vacío = no se regala. El secreto del canje NO va aquí: es el archivo
# secrets/dardoventas/secreto (chmod 600), que solo monta oficio_notifier.
DARDOVENTAS_PRO_HASTA=
