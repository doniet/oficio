# Oficios Cuba - Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=production

# Database
DATABASE_PATH=./data/oficios.db

# JWT Authentication
# IMPORTANT: Change this in production! Use a strong random string
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost

# Stripe Payments (optional - for subscriptions)
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Subscription Plan Prices (USD/month)
PLAN_BASIC_PRICE=9.99
PLAN_PRO_PRICE=19.99
PLAN_PREMIUM_PRICE=39.99

# Email (optional - for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=Oficios Cuba <noreply@oficioscuba.com>

# File Upload (optional - for images)
# UPLOAD_MAX_SIZE=5242880
# UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100