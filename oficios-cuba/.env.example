# Copia a .env (chmod 600). Nunca subas .env al repo.

# Obligatorio: mínimo 32 caracteres aleatorios. Genera uno con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# true = siembra cuentas y datos de demostración y simula los pagos de planes.
DEMO_MODE=true

# Precios de los planes (USD/mes). Gratis siempre es 0.
PLAN_BASICO_USD=1
PLAN_PROFESIONAL_USD=10

# Tasa de respaldo CUP por 1 USD. La real la sirve nginx desde dardoventas.com/tasas.json.
TASA_CUP_USD=730

# Login con Google real (OAuth Client ID de tipo "Web", origen https://oficio.dardoit.com,
# redirect https://oficio.dardoit.com/auth/google). Vacío + DEMO_MODE=true = Google simulado.
# Ojo: la API necesita salida a www.googleapis.com para bajar las llaves públicas de Google.
GOOGLE_CLIENT_ID=

# Push FCM: no va aquí. Lo envía oficio_notifier con secrets/fcm/cuenta.json (ver DOCKER.md).
